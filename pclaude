#!/usr/bin/env bash
# pclaude — run Claude Code in the yolopod container, scoped to the current directory.
#
# Every argument is passed straight through to `claude`. The launcher's own
# options are namespaced with --pclaude-* so they can never collide.
set -euo pipefail

# One login for host and container. On macOS Claude Code keeps its login in the Keychain,
# which the Linux container cannot reach; there it reads ~/.claude/.credentials.json. Every
# token refresh revokes the previous refresh token, so a copy that falls behind is dead:
# keep both in step, and whichever expires later wins. The item name is Claude Code's own
# (undocumented) one — if it ever changes, this fails as "not logged in".
KEYCHAIN_ITEM="Claude Code-credentials"
KEYCHAIN_ACCOUNT="${USER:-$(id -un)}"
CREDS="$HOME/.claude/.credentials.json"

# Prints the expiry of the credentials JSON on stdin, or 0 if it isn't a usable login.
# Secrets only ever travel through stdin, never argv, so they don't show up in `ps`.
creds_expiry() {
  local json key expiry
  json="$(cat)"
  for key in accessToken refreshToken; do
    # plutil reports a missing key on stdout, so only its exit status is reliable.
    printf '%s' "$json" | plutil -extract "claudeAiOauth.$key" raw -o /dev/null - >/dev/null 2>&1 \
      || { echo 0; return; }
  done
  expiry="$(printf '%s' "$json" | plutil -extract claudeAiOauth.expiresAt raw -o - - 2>/dev/null)"
  case "$expiry" in ''|*[!0-9]*) echo 0 ;; *) echo "$expiry" ;; esac
}

# Fails if neither side holds a usable login.
sync_credentials() {
  local keychain file k f hex
  keychain="$(security find-generic-password -s "$KEYCHAIN_ITEM" -a "$KEYCHAIN_ACCOUNT" -w 2>/dev/null || true)"
  file="$(cat "$CREDS" 2>/dev/null || true)"
  k="$(printf '%s' "$keychain" | creds_expiry)"
  f="$(printf '%s' "$file" | creds_expiry)"

  if [ "$k" -gt "$f" ]; then
    (umask 077 && printf '%s' "$keychain" >"$CREDS.new") && mv "$CREDS.new" "$CREDS"
  elif [ "$f" -gt "$k" ]; then
    # `security -i` reads the command from stdin; -X takes the value hex-encoded. Its exit
    # status doesn't reliably reflect the inner command, so read the item back instead.
    hex="$(printf '%s' "$file" | od -An -v -tx1 | tr -d ' \n')"
    printf 'add-generic-password -U -s "%s" -a "%s" -X %s\n' "$KEYCHAIN_ITEM" "$KEYCHAIN_ACCOUNT" "$hex" \
      | security -i >/dev/null 2>&1 || true
    [ "$(security find-generic-password -s "$KEYCHAIN_ITEM" -a "$KEYCHAIN_ACCOUNT" -w 2>/dev/null)" = "$file" ] \
      || echo "pclaude: could not update the Keychain; host 'claude' may ask you to log in" >&2
  fi
  [ "$k" -gt 0 ] || [ "$f" -gt 0 ]
}

# Sourcing the launcher (as test.sh does) only loads the functions above.
(return 0 2>/dev/null) && return

NAME=pclaude
PREFIX=PCLAUDE
TOOL="Claude Code"
FORWARD=(ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_MODEL
         CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX)
SHARE="${PCLAUDE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/yolopod}"
[ -f "$SHARE/lib.sh" ] || { echo "pclaude: no lib.sh in $SHARE — re-run install.sh from the repo" >&2; exit 1; }
# shellcheck source=lib.sh
source "$SHARE/lib.sh"

harness_examples() {
  cat <<'EOF'
  pclaude                       Interactive session in the current directory
  pclaude -p "fix the tests"    Print mode
  pclaude --model opus mcp list Any claude flag or subcommand
EOF
}

macos() { [ "$(uname -s)" = Darwin ]; }

harness_before() {
  # Claude Code stores its state here; create both so Podman doesn't make them dirs.
  mkdir -p "$HOME/.claude"
  [ -e "$HOME/.claude.json" ] || echo '{}' >"$HOME/.claude.json"
  if macos; then
    sync_credentials || die "not logged in — run 'claude /login' on the host, then rerun pclaude"
  fi
}

harness_mounts() {
  volume "$HOME/.claude" /home/node/.claude
  volume "$HOME/.claude.json" /home/node/.claude.json
}

harness_cmd() {
  cmd=(claude)
  [ "$(opt NO_YOLO)" = 1 ] || cmd+=(--dangerously-skip-permissions)
}

# Hand any token the container refreshed back to the Keychain.
harness_after() {
  if macos; then sync_credentials || true; fi
}

yolopod_main "$@"
